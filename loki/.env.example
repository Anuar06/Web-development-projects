# LOKI backend configuration
# Copy this file to .env and fill in what you use.

PORT=3000

# Only set this if LOKI runs somewhere other than your own machine.
# It must match the redirect URI registered in Google Cloud Console.
# BASE_URL=http://localhost:3000

# ── Google (schedule + flagged mail + drafts) ────────────────────────────
# Create at https://console.cloud.google.com/apis/credentials — see README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── AI model (voice chat, briefing replies, flashcards, drafts) ─────────
# Option A — Claude: create an API key at https://console.anthropic.com
# (note: a claude.ai subscription does NOT include API access — the key is
# separate, billed per token; LOKI's usage is typically cents per day).
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# Option B — Ollama (free, local): install from https://ollama.com,
# `ollama pull <model>`, and LOKI auto-detects it. Nothing to set unless
# you want to pin a model or a non-default URL:
# OLLAMA_MODEL=
# OLLAMA_URL=http://localhost:11434

# Force a provider instead of auto-detection: anthropic | ollama | off
# AI_PROVIDER=auto
