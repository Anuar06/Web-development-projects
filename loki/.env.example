# LOKI backend configuration
# Copy this file to .env and fill in the Google values.

PORT=3000

# Only set this if LOKI runs somewhere other than your own machine.
# It must match the redirect URI registered in Google Cloud Console.
# BASE_URL=http://localhost:3000

# Google OAuth client — see README.md "Connect LOKI to Google" for the
# step-by-step Google Cloud Console setup.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
